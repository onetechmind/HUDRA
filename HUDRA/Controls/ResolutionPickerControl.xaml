<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HUDRA.Controls.ResolutionPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HUDRA.Controls"
    xmlns:helpers="using:HUDRA.Helpers"
    xmlns:ap="using:HUDRA.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    
    <StackPanel Spacing="8">
        <!-- Labels -->
        <Grid Width="280">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Resolution"
                       FontSize="14"
                       Foreground="#CCFFFFFF"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       IsTabStop="False"
                       Grid.Column="0"/>

            <TextBlock Text="Refresh Rate"
                       FontSize="14"
                       Foreground="#CCFFFFFF"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       IsTabStop="False"
                       Grid.Column="2"/>
        </Grid>

        <Grid Width="280">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Both ComboBoxes are gamepad focus candidates; the control
                 (IGamepadElementHost) owns their deferred-commit dropdown
                 semantics and the FocusIndicatorLayer renders the ring -->
            <ComboBox x:Name="ResolutionComboBox"
                          Grid.Column="0"
                          Style="{StaticResource HudraComboBoxStyle}"
                          ItemContainerStyle="{StaticResource HudraComboBoxItemStyle}"
                          HorizontalAlignment="Stretch"
                          ap:GamepadNavigation.IsEnabled="True"
                          ap:GamepadNavigation.NavigationOrder="4"
                          helpers:GamepadComboBoxHelper.IsGamepadEnabled="True"/>

            <ComboBox x:Name="RefreshRateComboBox"
                          Grid.Column="2"
                          Style="{StaticResource HudraComboBoxStyle}"
                          ItemContainerStyle="{StaticResource HudraComboBoxItemStyle}"
                          HorizontalAlignment="Stretch"
                          ap:GamepadNavigation.IsEnabled="True"
                          ap:GamepadNavigation.NavigationOrder="4"
                          helpers:GamepadComboBoxHelper.IsGamepadEnabled="True"/>
        </Grid>
    </StackPanel>
    
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
	<EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HUDRA</RootNamespace>

    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
	  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

	  <WindowsPackageType>None</WindowsPackageType>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HUDRA_Logo.ico</ApplicationIcon>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Version information for Beta release -->
    <!-- Wildcard versioning: build number = days since Jan 1 2000, revision = seconds since midnight / 2 -->
    <Deterministic>false</Deterministic>
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.*</AssemblyVersion>
    <FileVersion>0.9.*</FileVersion>
    <InformationalVersion>0.9.0-beta</InformationalVersion>
    <Product>HUDRA</Product>
    <Company>HUDRA Team</Company>
    <Copyright>Copyright 2024-2025</Copyright>
    <Description>HUDRA - Heads-Up Display Runtime Assistant for AMD Ryzen Handheld Gaming Devices</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Services\Web\wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\HUDRA_Logo.ico" />
    <None Remove="Assets\HUDRA_Logo_64x64.ico" />
    <None Remove="Assets\performance-settings-icon.png" />
    <None Remove="Assets\tick.wav" />
    <None Remove="Configuration\Settings.xml" />
    <None Remove="Controls\AudioControlsControl.xaml" />
    <None Remove="Controls\BrightnessControlControl.xaml" />
    <None Remove="Controls\FanControlControl.xaml" />
    <None Remove="Controls\FanCurveControl.xaml" />
    <None Remove="Controls\TdpPickerControl.xaml" />
    <None Remove="External Resources\AMD\ADLX\ADLX_3DSettings.dll" />
    <None Remove="External Resources\AMD\ADLX\ADLX_AutoTuning.dll" />
    <None Remove="External Resources\AMD\ADLX\ADLX_DisplaySettings.dll" />
    <None Remove="External Resources\AMD\ADLX\ADLX_PerformanceMetrics.dll" />
    <None Remove="Tools\RTSSHooks.dll" />
    <None Remove="Tools\RTSSHooks64.dll" />
    <None Remove="Tools\RTSSSharedMemoryNET.dll" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Configuration\Settings.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="External Resources\AMD\ADLX\ADLX_3DSettings.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="External Resources\AMD\ADLX\ADLX_AutoTuning.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="External Resources\AMD\ADLX\ADLX_DisplaySettings.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="External Resources\AMD\ADLX\ADLX_PerformanceMetrics.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\RTSSHooks.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\RTSSHooks64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\RTSSSharedMemoryNET.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\PawnIO\RyzenSMU.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\PawnIO\LpcIO.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\PawnIO\LICENSE-modules.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240428000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
	<PackageReference Include="MouseKeyHook" Version="5.7.1" />
    <Manifest Include="$(ApplicationManifest)" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Management.Automation" Version="7.4.6" />
    <PackageReference Include="GameLib.NET" Version="1.4.1" />
	<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
	<PackageReference Include="craftersmine.SteamGridDB.Net" Version="1.1.7" />
	<PackageReference Include="QRCoder" Version="1.6.0" />
	  <Reference Include="RTSSSharedMemoryNET">
		  <HintPath>Tools\RTSSSharedMemoryNET.dll</HintPath>
	  </Reference>
  </ItemGroup>


<Page
    x:Class="HUDRA.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HUDRA.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="0">
        <StackPanel
            x:Name="SettingsRootPanel"
            MaxWidth="280"
            Margin="0,15,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="20">

            <Border>
                <TextBlock
                    Padding="0,15,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Cascadia Code"
                    FontSize="18"
                    FontWeight="SemiBold"
                    IsTabStop="False"
                    Text="SETTINGS" />
            </Border>

            <!--  Default Profile  -->
            <controls:NavigableExpander
                x:Name="DefaultProfileExpander"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Stretch">
                <controls:NavigableExpander.Header>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Text="&#xE771;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Code"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Default Profile" />
                    </StackPanel>
                </controls:NavigableExpander.Header>
                <controls:NavigableExpander.Body>
                    <controls:DefaultProfileControl x:Name="DefaultProfileControl" />
                </controls:NavigableExpander.Body>
            </controls:NavigableExpander>

            <!--  Power Profile Control  -->
            <controls:NavigableExpander
                x:Name="PowerProfileExpander"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Stretch">
                <controls:NavigableExpander.Header>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="20"
                            Text="&#xE83F;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Code"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Power Profile" />
                    </StackPanel>
                </controls:NavigableExpander.Header>
                <controls:NavigableExpander.Body>
                    <controls:PowerProfileControl x:Name="PowerProfileControl" x:FieldModifier="public" />
                </controls:NavigableExpander.Body>
            </controls:NavigableExpander>

            <!--  Game Detection Settings  -->
            <controls:NavigableExpander
                x:Name="GameDetectionExpander"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Stretch">
                <controls:NavigableExpander.Header>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Text="&#xE7FC;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Code"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Game Detection" />
                    </StackPanel>
                </controls:NavigableExpander.Header>
                <controls:NavigableExpander.Body>
                    <controls:GameDetectionControl x:Name="GameDetectionControl" />
                </controls:NavigableExpander.Body>
            </controls:NavigableExpander>
            <!--  Startup & Windows Integration  -->
            <controls:NavigableExpander
                x:Name="StartupSettingsExpander"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Stretch">
                <controls:NavigableExpander.Header>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Text="&#xE8FC;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Code"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Startup &amp; Options" />
                    </StackPanel>
                </controls:NavigableExpander.Header>
                <controls:NavigableExpander.Body>
                    <controls:StartupOptionsControl x:Name="StartupOptionsControl" />
                </controls:NavigableExpander.Body>
            </controls:NavigableExpander>

            <!--  Web Remote  -->
            <controls:NavigableExpander
                x:Name="WebRemoteExpander"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Stretch">
                <controls:NavigableExpander.Header>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Text="&#xE774;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Code"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Web Remote" />
                    </StackPanel>
                </controls:NavigableExpander.Header>
                <controls:NavigableExpander.Body>
                    <StackPanel Padding="15" Spacing="12">

                        <!--  Enable Toggle (matches RTSS / Startup toggle styling)  -->
                        <Border
                            Padding="20,5"
                            Background="#22FFFFFF"
                            CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Code"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    IsTabStop="False"
                                    Text="Enable Web Remote" />
                                <ToggleSwitch
                                    x:Name="WebRemoteToggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Toggled="WebRemoteToggle_Toggled" />
                            </Grid>
                        </Border>

                        <!--  Port and PIN side by side  -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Port  -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    FontFamily="Cascadia Code"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="Port" />
                                <NumberBox
                                    x:Name="WebRemotePortBox"
                                    Maximum="65535"
                                    Minimum="1024"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="WebRemotePort_ValueChanged"
                                    Value="5069" />
                            </StackPanel>

                            <!--  PIN  -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    FontFamily="Cascadia Code"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="PIN (4-6 digits)" />
                                <PasswordBox
                                    x:Name="WebRemotePinBox"
                                    MaxLength="6"
                                    PlaceholderText="Enter PIN" />
                            </StackPanel>
                        </Grid>

                        <!--  Save PIN Button (centered, wider)  -->
                        <Button
                            x:Name="WebRemoteSavePinButton"
                            Height="40"
                            MinWidth="120"
                            HorizontalAlignment="Center"
                            Click="WebRemoteSavePin_Click"
                            Content="Save PIN"
                            CornerRadius="16" />

                        <!--  Status  -->
                        <TextBlock
                            x:Name="WebRemoteStatusText"
                            HorizontalAlignment="Center"
                            FontFamily="Cascadia Code"
                            FontSize="12"
                            Foreground="DarkViolet"
                            Text="Disabled"
                            TextWrapping="Wrap" />

                        <!--  QR Code (visible only when running)  -->
                        <Image
                            x:Name="WebRemoteQrCode"
                            Width="140"
                            Height="140"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed" />
                    </StackPanel>
                </controls:NavigableExpander.Body>
            </controls:NavigableExpander>

            <!--  Copy Debug Info Button  -->
            <Button
                x:Name="CopyDebugInfoButton"
                Width="140"
                Height="45"
                HorizontalAlignment="Stretch"
                Click="CopyDebugInfoButton_Click"
                Content="Copy Debug Info" />

            <!--  Recovery for a wedged gamepad state. Deliberately NOT a gamepad
                  focus candidate: it must be reachable by mouse/touch precisely
                  when gamepad input is not working.  -->
            <Button
                x:Name="ResetGamepadInputButton"
                Width="140"
                Height="45"
                HorizontalAlignment="Stretch"
                Click="ResetGamepadInputButton_Click"
                Content="Reset Gamepad Input" />

            <!--  Recovery for a user who declined the first-launch PawnIO prompt: lets
                  them install the TDP/fan control driver later without a fresh install.  -->
            <Button
                x:Name="InstallPawnIoButton"
                Width="140"
                Height="45"
                HorizontalAlignment="Stretch"
                Click="InstallPawnIoButton_Click"
                Content="Install PawnIO Driver" />

            <!--  Version Display  -->
            <TextBlock
                x:Name="VersionText"
                HorizontalAlignment="Center"
                FontFamily="Cascadia Code"
                FontSize="12"
                Opacity="0.6"
                Text="HUDRA Beta" />

        </StackPanel>
    </Grid>
</Page>
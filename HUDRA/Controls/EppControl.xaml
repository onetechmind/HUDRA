<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HUDRA.Controls.EppControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="using:HUDRA.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="280" Spacing="4">
        <!--  EPP Slider - gamepad focus candidate (ring drawn by FocusIndicatorLayer)  -->
        <Border
            x:Name="EppFocusBorder"
            Padding="15,10"
            Background="#22FFFFFF"
            CornerRadius="12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Code"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#CCFFFFFF"
                        IsTabStop="False"
                        Text="EPP" />
                    <TextBlock
                        x:Name="EppValueLabel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Code"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#CCFFFFFF"
                        IsTabStop="False"
                        Text="--" />
                </Grid>
                <Slider
                    x:Name="EppSlider"
                    Margin="0,4,0,0"
                    ap:GamepadNavigation.IsEnabled="True"
                    ap:GamepadNavigation.NavigationOrder="3"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="5"
                    StepFrequency="5"
                    TickFrequency="25"
                    ValueChanged="OnEppSliderValueChanged" />
            </StackPanel>
        </Border>

        <TextBlock
            x:Name="EppCaption"
            HorizontalAlignment="Center"
            FontFamily="Cascadia Code"
            FontSize="12"
            Foreground="#99FFFFFF"
            Text="0 = CPU boost · 100 = Efficiency" />
    </StackPanel>
</UserControl>

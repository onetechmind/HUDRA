<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HUDRA.Controls.AudioControlsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HUDRA.Controls"
    xmlns:ap="using:HUDRA.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  Inner controls are individual gamepad focus candidates; the shared
          FocusIndicatorLayer renders the focus ring  -->
    <Grid Width="280" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="MuteButton"
                    Grid.Column="0"
                    Width="50"
                    Height="50"
                    ap:GamepadNavigation.IsEnabled="True"
                    ap:GamepadNavigation.NavigationOrder="6">
            <FontIcon x:Name="MuteButtonIcon"
                          FontFamily="Segoe MDL2 Assets"
                          Glyph="&#xE767;"
                          FontSize="20"/>
        </Button>

        <Slider x:Name="VolumeSlider"
                    Grid.Column="1"
                    Margin="10,0,2,0"
                    Minimum="0"
                    Maximum="100"
                    SmallChange="5"
                    ap:GamepadNavigation.IsEnabled="True"
                    ap:GamepadNavigation.NavigationOrder="6"/>
    </Grid>

</UserControl>
